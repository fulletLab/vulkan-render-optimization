* {
    color: #e4e9f2;
    selection-background-color: #2d7ed6;
    selection-color: #ffffff;
}

QWidget,
QMainWindow,
QDialog,
QFrame,
QStackedWidget,
QScrollArea,
QScrollArea > QWidget > QWidget,
*[dockWidgetContent="true"] {
    background-color: #1a1d22;
    color: #e4e9f2;
}

QMenuBar,
QMenu,
QToolBar,
QStatusBar,
ads--CDockAreaTitleBar,
#dockAreaTitleBar,
#tabsContainerWidget,
#sideTabsContainerWidget {
    background-color: #20242b;
    color: #e4e9f2;
}

QMenuBar::item,
QLabel,
QHeaderView,
ads--CDockWidgetTab QLabel,
#dockWidgetTabLabel,
#tabCloseButton,
#tabsMenuButton,
#detachGroupButton,
#dockAreaAutoHideButton,
#dockAreaMinimizeButton,
#dockAreaCloseButton {
    background-color: transparent;
}

QMenuBar::item:selected,
QMenu::item:selected,
QToolButton:hover,
QPushButton:hover,
#tabCloseButton:hover,
#tabsMenuButton:hover,
#detachGroupButton:hover,
#dockAreaAutoHideButton:hover,
#dockAreaMinimizeButton:hover,
#dockAreaCloseButton:hover {
    background-color: #343c48;
}

QMenu,
QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QTreeWidget,
QTableWidget,
QTableView,
QTreeView,
QListView,
QProgressBar,
ads--CDockAreaWidget,
ads--CDockWidgetTab {
    border-color: #303743;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #11151b;
    color: #e8edf5;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #2d7ed6;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled,
QPushButton:disabled,
QToolButton:disabled {
    background-color: #20242b;
    color: #6f7b8a;
    border-color: #303743;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background-color: #252b34;
    border-color: #3a4350;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: #303743;
}

QTreeWidget,
QTableWidget,
QTableView,
QTreeView,
QListView {
    background-color: #181c22;
    alternate-background-color: #1f242b;
    color: #e4e9f2;
    gridline-color: #252b34;
}

QTreeWidget::item,
QTableWidget::item {
    background-color: transparent;
}

QTreeWidget::item:selected,
QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #2d7ed6;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #2a3039;
    color: #e8edf5;
    border-color: #3a4350;
}

QPushButton,
QToolButton {
    background-color: #2a3039;
    color: #f2f5f9;
    border-color: #46515f;
}

QPushButton:pressed,
QToolButton:pressed,
QToolButton:checked {
    background-color: #2d7ed6;
    border-color: #4f9ced;
    color: #ffffff;
}

QTabWidget::pane,
QTabBar::tab {
    background-color: #20242b;
    color: #aeb8c7;
    border-color: #303743;
}

QTabBar::tab:hover {
    background-color: #29303a;
    color: #f2f5f9;
}

QTabBar::tab:selected,
ads--CDockWidgetTab[activeTab="true"],
ads--CDockWidgetTab[focused="true"] {
    background-color: #1a1d22;
    color: #ffffff;
    border-color: #2d7ed6;
}

ads--CDockWidgetTab {
    background-color: #20242b;
    color: #aeb8c7;
}

ads--CDockWidgetTab[activeTab="true"] QLabel,
ads--CDockWidgetTab[focused="true"] QLabel {
    color: #ffffff;
}

QProgressBar {
    background-color: #11151b;
    color: #dce4ef;
}

QProgressBar::chunk {
    background-color: #2d7ed6;
}

QSplitter::handle {
    background-color: #303743;
}

QSplitter::handle:hover {
    background-color: #46515f;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #15181d;
}

QScrollBar::handle {
    background-color: #3a4350;
}

QScrollBar::handle:hover {
    background-color: #526071;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background-color: transparent;
}
